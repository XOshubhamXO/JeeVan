# ─── JeeVan Platform ───
# Primary Environment Configuration
# Never commit this file to version control

# ─── Database: Supabase (Self-Hosted / Free Tier) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# ─── Primary APIs ───
# Country Data
REST_COUNTRIES_API=https://restcountries.com/v3.1
GEONAMES_USERNAME=your_geonames_user

# Geolocation
IPINFO_API_KEY=your_ipinfo_key
IPAPI_CO_URL=https://ipapi.co

# Weather (Open-Meteo needs NO key)
OPEN_METEO_API=https://api.open-meteo.com/v1
OPENWEATHERMAP_API_KEY=your_openweathermap_key
NASA_API_KEY=your_nasa_key

# Translation
LIBRETRANSLATE_API=https://libretranslate.com
DEEPL_API_KEY=your_deepl_key

# Market Rates
AGMARKNET_API=https://api.data.gov.in/resource
OPEN_FOOD_FACTS_API=https://world.openfoodfacts.org/api/v2

# AI
GROQ_API_KEY=your_groq_key
GOOGLE_AI_API_KEY=your_google_ai_key

# ─── CDN & Media ───
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=JeeVan
NEXT_PUBLIC_CLOUDINARY_VIDEO_URL=https://res.cloudinary.com/your_cloud/video/upload/your_video.mp4
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=your_uploadcare_key
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1

# ─── Payments: Razorpay ───
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_secret

# ─── Email: Mailchimp ───
MAILCHIMP_API_KEY=your_mailchimp_key
MAILCHIMP_LIST_ID=your_audience_id

# ─── Market: Agmarknet ───
AGMARKNET_API_KEY=your_agmarknet_key

# ─── Analytics ───
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_id
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Platform Config ───
NEXT_PUBLIC_PLATFORM_NAME=JeeVan
NEXT_PUBLIC_PLATFORM_URL=https://jeevan.farm
ADMIN_ALPHA_PASSKEY_HASH=$2b$12$placeholder_hash_alpha
ADMIN_BETA_PASSKEY_HASH=$2b$12$placeholder_hash_beta

# ─── Feature Flags ───
NEXT_PUBLIC_ENABLE_NATURE_ENGINE=true
NEXT_PUBLIC_ENABLE_AI_ADVISORY=true
NEXT_PUBLIC_ENABLE_MARKET_RATES=true
